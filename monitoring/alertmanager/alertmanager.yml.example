global:
  smtp_smarthost: smtp.example.com:587
  smtp_from: alerts@example.com
  smtp_auth_username: your-smtp-username
  smtp_auth_password: REPLACE_WITH_SMTP_APP_PASSWORD
  smtp_require_tls: true

route:
  receiver: attack-email
  group_by: [alertname]
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 1h

receivers:
  - name: attack-email
    email_configs:
      - to: your-email@example.com
        send_resolved: true
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/slack_workflow_url
        send_resolved: true
        payload:
          alert_name: '{{ .CommonLabels.alertname }}'
          status: '{{ .Status }}'
          severity: '{{ .CommonLabels.severity }}'
          summary: '{{ .CommonAnnotations.summary }}'
          description: '{{ .CommonAnnotations.description }}'
